# Backend environment sample: see apps/backend/.env.example
# Frontend environment sample: see apps/frontend/.env.example
# JWT Secrets must each be at least 32 characters long AND distinct from each other in production:
JWT_SECRET="generate_a_strong_random_secret_at_least_32_chars_tenant"
JWT_REFRESH_SECRET="generate_a_strong_random_refresh_secret_at_least_32_chars"
JWT_PLATFORM_SECRET="generate_a_strong_random_platform_secret_at_least_32_chars"
ALLOW_SELF_ONBOARDING=false
# Bootstrap platform accounts (REQUIRED in production; in development, auto-generated if omitted)
SUPER_ADMIN_NAME="Super Administrator"
SUPER_ADMIN_EMAIL="superadmin@restaurantpos.com"
SUPER_ADMIN_PASSWORD="ChangeThisPassword123!"
SUPPORT_NAME="Global Platform Support"
SUPPORT_EMAIL="support@restaurantpos.com"
SUPPORT_PASSWORD="ChangeThisPassword123!"

