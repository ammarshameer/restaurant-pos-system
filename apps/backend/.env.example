# ==============================================================================
# RESTAURANT POS SYSTEM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# MODE 1: OFFLINE (Desktop Electron + SQLite)
# DATABASE_PROVIDER="sqlite"
# DATABASE_URL="file:./prisma/dev.db"

# MODE 2: ONLINE (Multi-Tenant SaaS + Managed PostgreSQL on Render/Neon/Supabase)
DATABASE_PROVIDER="postgresql"
DATABASE_URL="postgresql://user:password@host:5432/restaurant_pos?sslmode=require"

# Server Settings
PORT=3000
NODE_ENV="production"

# Frontend / CORS Locking
FRONTEND_URL="https://dimlight-cafe.vercel.app"

# JWT Authentication Secrets (CRITICAL FOR PRODUCTION)
# Must each be at least 32 characters long AND distinct from each other.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="generate_a_strong_random_secret_at_least_32_chars_tenant"
JWT_REFRESH_SECRET="generate_a_strong_random_refresh_secret_at_least_32_chars"
JWT_PLATFORM_SECRET="generate_a_strong_random_platform_secret_at_least_32_chars"

# Self-Onboarding Gate (Strictly false in production multi-tenant SaaS)
ALLOW_SELF_ONBOARDING=false

# Bootstrap Platform Credentials (REQUIRED in production; in development, if omitted,
# high-entropy passwords are auto-generated and written to .dev-platform-credentials.json)
SUPER_ADMIN_NAME="Super Administrator"
SUPER_ADMIN_EMAIL="superadmin@restaurantpos.com"
SUPER_ADMIN_PASSWORD="ChangeThisPassword123!"

# Bootstrap Global Support Account
SUPPORT_NAME="Global Platform Support"
SUPPORT_EMAIL="support@restaurantpos.com"
SUPPORT_PASSWORD="ChangeThisPassword123!"

# Development Flags (Only evaluated when NODE_ENV !== 'production')
ALLOW_MOCK_AUTH=false
