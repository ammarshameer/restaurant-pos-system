# ==============================================================================
# RESTAURANT POS SYSTEM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# MODE 1: OFFLINE (Desktop Electron + SQLite)
# DATABASE_PROVIDER="sqlite"
# DATABASE_URL="file:./prisma/dev.db"

# MODE 2: ONLINE (Multi-Tenant SaaS + Managed PostgreSQL on Render/Neon/Supabase)
DATABASE_PROVIDER="postgresql"
DATABASE_URL="postgresql://user:password@host:5432/restaurant_pos?sslmode=require"

# Server Settings
PORT=3000
NODE_ENV="production"

# Frontend / CORS Locking
# Production deployment: backend on Contabo -> https://pos.gsmpilot.com
# FRONTEND_URL must be the EXACT Vercel production URL of the frontend.
# Multiple origins are supported as a comma-separated list, e.g.
#   FRONTEND_URL="https://dimlight-cafe.vercel.app,https://pos.gsmpilot.com"
# (preview deployment URLs are different origins and would each need adding).
# Current production frontend: https://dimlight-cafe.vercel.app
FRONTEND_URL="https://dimlight-cafe.vercel.app"

# JWT Authentication Secrets (CRITICAL FOR PRODUCTION)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="generate_a_strong_random_secret_per_environment"
JWT_REFRESH_SECRET="generate_a_strong_random_refresh_secret_per_environment"

