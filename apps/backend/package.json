{
  "name": "@restaurant-pos/backend",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc --skipLibCheck",
    "start": "node dist/index.js",
    "test": "npm run test:unit",
    "test:unit": "tsx --test tests/*.test.ts",
    "test:acceptance": "tsx scripts/verify-acceptance.ts",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:migrate:check": "bash scripts/check-migration-baseline.sh",
    "db:migrate:baseline": "bash scripts/baseline-live-db.sh",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:backfill": "tsx prisma/backfill-multi-tenant.ts",
    "db:studio": "prisma studio",
    "db:backup": "bash scripts/backup-postgres.sh",
    "db:restore": "bash scripts/restore-postgres.sh"
  },
  "dependencies": {
    "@prisma/client": "^5.10.2",
    "@sentry/node": "^9.47.2",
    "archiver": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "redis": "^4.6.13",
    "socket.io": "^4.6.1",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.4",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.11.19",
    "prisma": "^5.10.2",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "qs": "6.16.0"
  }
}
