# Base URL for the backend API (MUST include the /api suffix —
# the backend mounts every route under /api).
#
# Local development (vite dev server, /api is proxied to localhost:3000):
VITE_API_URL="http://localhost:3000/api"
#
# Cloud production (Contabo backend behind Cloudflare + Caddy):
#   Backend URL: https://pos.gsmpilot.com
#   Health:      https://pos.gsmpilot.com/health
#   WebSocket:   wss://pos.gsmpilot.com/socket.io  (derived automatically)
#
# On Vercel set this exact value in
#   Project Settings -> Environment Variables -> VITE_API_URL
# Vercel dashboard values take precedence over committed .env files.
# VITE_API_URL="https://pos.gsmpilot.com/api"
