{
  "name": "restaurant-pos",
  "version": "1.0.1",
  "private": true,
  "description": "Full-stack online Restaurant POS and Management System",
  "scripts": {
    "dev:backend": "cd apps/backend && npm run dev",
    "dev:frontend": "cd apps/frontend && npm run dev",
    "build:backend": "cd apps/backend && npm run build",
    "build:frontend": "cd apps/frontend && npm run build",
    "build": "npm run build:backend && npm run build:frontend",
    "start:backend": "cd apps/backend && npm start",
    "start:frontend": "cd apps/frontend && npm run preview",
    "db:backfill": "cd apps/backend && npm run db:backfill",
    "test:acceptance": "cd apps/backend && npm run test:acceptance",
    "install:all": "npm install && cd apps/backend && npm install && cd ../frontend && npm install && cd ../.. && npm install --prefix electron/print-helper",
    "print-helper:start": "npm --prefix electron/print-helper exec -- electron electron/print-helper",
    "print-helper:pack": "npm --prefix electron/print-helper exec -- electron-builder --dir --config electron-builder.print-helper.json",
    "dist:print-helper": "npm --prefix electron/print-helper exec -- electron-builder --win --config electron-builder.print-helper.json",
    "test:print-helper": "node electron/printing/selftest.js"
  },
  "keywords": [
    "pos",
    "restaurant",
    "management",
    "react",
    "nodejs",
    "typescript",
    "online"
  ],
  "author": "",
  "license": "MIT"
}
